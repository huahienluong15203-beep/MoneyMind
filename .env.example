# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MONEYMIND (FILE MẪU)
# Sao chép file này thành .env và điền thông tin thật của bạn
# ==============================================================================

# Tài khoản Gmail máy chủ gửi email xác nhận OTP
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# Cấu hình máy chủ SMTP của Gmail
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Tùy chọn: Google Apps Script Web App
GOOGLE_APPS_SCRIPT_URL=

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
